!/relatorios/distribuicao_imagens_classes.csv
!/relatorios/execucao.json
!/relatorios/inspecao_mascaras.json
!/relatorios/metricas_comparativas.csv
!/relatorios/preparacao.json
!/relatorios/validacao_entrega.json

# Experimentos: métricas, curvas e exemplos; sem pesos nem testes funcionais
